generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  IC
  MANAGER
}

enum InviteStatus {
  PENDING
  ACCEPTED
}

enum InitiativeStatus {
  ABERTA
  ENCERRADA
}

// ---------- Conta ----------
model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  phone          String?
  passwordHash   String? // scrypt; nulo em contas antigas, criadas antes da senha
  role           Role
  onboardingStep Int      @default(1) // 1 conta criada · 2 primeiro projeto · 3 time e iniciativas
  title          String?
  avatar         Json? // {skin,bg,hairStyle,shirtStyle,facialHair,glasses,glassesShape,earrings,lashes,crown}
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  projectsOwned Project[]
  drafts        Draft[]
  persons       Person[]
  loginTokens   LoginToken[]
}

model LoginToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model WishlistEntry {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      String
  focus     String?
  teamSize  String?
  pains     String[]
  channels  String[]
  beta      Boolean  @default(false)
  consent   Boolean  @default(false)
  editToken String? // hash do token guardado no navegador de quem se inscreveu
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Projeto ----------
model Project {
  id        String    @id @default(uuid())
  name      String
  segment   String
  tagline   String?
  strategy  String?
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  indicators      KeyIndicator[]
  competitors     Competitor[]
  referenceLinks  ReferenceLink[]
  leaderships     Leadership[]
  skillCategories SkillCategory[]
  skills          Skill[]
  invites         Invite[]
  squads          Squad[]
  persons         Person[]
  initiatives     Initiative[]

  @@index([ownerId])
}

model KeyIndicator {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  position  Int     @default(0)
}

model Competitor {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  position  Int     @default(0)
}

model ReferenceLink {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  host      String
  position  Int     @default(0)
}

model SkillCategory {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  skills    Skill[]
}

model Skill {
  id         String         @id @default(uuid())
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  categoryId String?
  category   SkillCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name       String
  position   Int            @default(0)
  ratings    SkillRating[]
  studyItems StudyItem[]
}

model Invite {
  id        String       @id @default(uuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  email     String
  position  Role
  status    InviteStatus @default(PENDING)
  createdAt DateTime     @default(now())

  @@unique([projectId, email])
}

// ---------- Time (contadores do hub; telas completas no Marco 2) ----------
model Squad {
  id          String            @id @default(uuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  color       String            @default("#B7A6FF")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  members     SquadMembership[]
  leaderships LeadershipSquad[]
}

model Person {
  id         String             @id @default(uuid())
  projectId  String
  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?              @relation(fields: [userId], references: [id])
  name       String
  title      String?
  email      String? // e-mail do convite; vincula ao User quando a pessoa cria a conta
  mainSkill  String?
  joinedAt   DateTime?
  avatar     Json?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  deletedAt  DateTime?
  squads     SquadMembership[]
  leads      Leadership?        @relation("LeaderPerson")
  powerUps   PowerUp[]
  deliveries Delivery[]
  ratings    SkillRating[]
  studyItems StudyItem[]
  reportsTo  LeadershipMember[] @relation("ReportsTo")
}

model SquadMembership {
  squadId  String
  squad    Squad   @relation(fields: [squadId], references: [id], onDelete: Cascade)
  personId String
  person   Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  crown    Boolean @default(false) // referência (champion) no squad

  @@id([squadId, personId])
}

model Initiative {
  id         String           @id @default(uuid())
  projectId  String
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product    String
  problem    String?
  need       String?
  status     InitiativeStatus @default(ABERTA)
  moment     Int?
  deliveries Delivery[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

// ---------- Rascunhos de deck de perguntas (PRD 6.2) ----------
model Draft {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     String // ex.: "project:new", "project:edit"
  entityId  String   @default("") // vazio quando é criação
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, scope, entityId])
}

// ---------- Administração: lideranças (M4) ----------
model Leadership {
  id        String             @id @default(uuid())
  projectId String
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  personId  String             @unique // a pessoa que lidera (carta no Time, convidada como manager)
  person    Person             @relation("LeaderPerson", fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime?
  members   LeadershipMember[]
  squads    LeadershipSquad[]

  @@index([projectId])
}

model LeadershipMember {
  leadershipId String
  leadership   Leadership @relation(fields: [leadershipId], references: [id], onDelete: Cascade)
  personId     String
  person       Person     @relation("ReportsTo", fields: [personId], references: [id], onDelete: Cascade)

  @@id([leadershipId, personId])
}

model LeadershipSquad {
  leadershipId String
  leadership   Leadership @relation(fields: [leadershipId], references: [id], onDelete: Cascade)
  squadId      String
  squad        Squad      @relation(fields: [squadId], references: [id], onDelete: Cascade)

  @@id([leadershipId, squadId])
}

// ---------- Decks da pessoa (M6) ----------
enum DeliveryStatus {
  ENTREGUE
  EM_ANDAMENTO
  PAUSADA
}

enum StudyType {
  CURSO
  LIVRO
  VIDEO
  ARTIGO
  PODCAST
  LINK
}

model PowerUp {
  id          String    @id @default(uuid())
  personId    String
  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  type        String // MENTORIA | CURSO | PROJETO
  name        String
  skill       String?
  frequency   String?
  progress    Int       @default(0) // 0-100
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([personId])
}

model Delivery {
  id           String         @id @default(uuid())
  personId     String
  person       Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  initiativeId String?
  initiative   Initiative?    @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  status       DeliveryStatus @default(ENTREGUE)
  role         String?
  impact       String?
  date         DateTime       @default(now())
  createdById  String?
  updatedById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
  links        DeliveryLink[]

  @@index([personId])
}

model DeliveryLink {
  id         String   @id @default(uuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  url        String
  host       String
}

model SkillRating {
  id           String   @id @default(uuid())
  personId     String
  person       Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  cycle        String // ex.: 2026-Q4
  selfScore    Int? // 1-5 (autoavaliação)
  managerScore Int? // 1-5 (só o manager)
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([personId, skillId, cycle])
}

model StudyItem {
  id        String    @id @default(uuid())
  personId  String
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  type      StudyType
  title     String
  url       String?
  skillId   String?
  skill     Skill?    @relation(fields: [skillId], references: [id], onDelete: SetNull)
  progress  Int       @default(0) // blocos concluídos
  total     Int       @default(10)
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([personId])
}
