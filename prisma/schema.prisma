generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  IC
  MANAGER
}

enum InviteStatus {
  PENDING
  ACCEPTED
}

enum InitiativeStatus {
  ABERTA
  ENCERRADA
}

// ---------- Conta ----------
model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  phone          String?
  passwordHash   String? // scrypt; nulo em contas antigas, criadas antes da senha
  role           Role
  onboardingStep Int      @default(1) // 1 conta criada · 2 primeiro projeto · 3 time e iniciativas
  title          String?
  avatar         Json? // {skin,bg,hairStyle,shirtStyle,facialHair,glasses,glassesShape,earrings,lashes,crown}
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  projectsOwned Project[]
  drafts        Draft[]
  persons       Person[]
  loginTokens   LoginToken[]
}

model LoginToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model WishlistEntry {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      String
  focus     String?
  teamSize  String?
  pains     String[]
  channels  String[]
  beta      Boolean  @default(false)
  consent   Boolean  @default(false)
  editToken String? // hash do token guardado no navegador de quem se inscreveu
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Projeto ----------
model Project {
  id        String    @id @default(uuid())
  name      String
  segment   String
  tagline   String?
  strategy  String?
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  indicators      KeyIndicator[]
  competitors     Competitor[]
  referenceLinks  ReferenceLink[]
  leaderships     Leadership[]
  skillCategories SkillCategory[]
  skills          Skill[]
  invites         Invite[]
  squads          Squad[]
  persons         Person[]
  initiatives     Initiative[]

  @@index([ownerId])
}

model KeyIndicator {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  position  Int     @default(0)
}

model Competitor {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  position  Int     @default(0)
}

model ReferenceLink {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  host      String
  position  Int     @default(0)
}

model SkillCategory {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  skills    Skill[]
}

model Skill {
  id         String         @id @default(uuid())
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  categoryId String?
  category   SkillCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name       String
  position   Int            @default(0)
  ratings    SkillRating[]
  studyItems StudyItem[]
}

model Invite {
  id        String       @id @default(uuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  email     String
  position  Role
  status    InviteStatus @default(PENDING)
  createdAt DateTime     @default(now())

  @@unique([projectId, email])
}

// ---------- Time (contadores do hub; telas completas no Marco 2) ----------
model Squad {
  id          String            @id @default(uuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  color       String            @default("#B7A6FF")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  members     SquadMembership[]
  leaderships LeadershipSquad[]
  cards       SquadCard[]
}

model Person {
  id           String             @id @default(uuid())
  projectId    String
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?              @relation(fields: [userId], references: [id])
  name         String
  title        String?
  email        String? // e-mail do convite; vincula ao User quando a pessoa cria a conta
  mainSkill    String?
  joinedAt     DateTime?
  avatar       Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?
  squads       SquadMembership[]
  leads        Leadership?        @relation("LeaderPerson")
  powerUps     PowerUp[]
  deliveries   Delivery[]
  ratings      SkillRating[]
  studyItems   StudyItem[]
  journey      JourneyGoal[]
  health       HealthCheckin[]
  reportsTo    LeadershipMember[] @relation("ReportsTo")
  squadCards   SquadCard[]
  personEvents PersonEvent[]
}

model SquadMembership {
  squadId  String
  squad    Squad   @relation(fields: [squadId], references: [id], onDelete: Cascade)
  personId String
  person   Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  crown    Boolean @default(false) // referência (champion) no squad

  @@id([squadId, personId])
}

model Initiative {
  id            String           @id @default(uuid())
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product       String
  problem       String?
  need          String?
  status        InitiativeStatus @default(ABERTA)
  moment        Int?
  deducedNeed   String? // necessidade deduzida pelo agente (PRECISA CONFIRMAR)
  tableOpenedAt DateTime? // quando o manager abriu a mesa (todas as dúvidas resolvidas)
  deliveries    Delivery[]
  doubts        AgentDoubt[]
  contextCards  ContextCard[]
  attachments   Attachment[]
  plays         ToolPlay[]
  momentReason  String?
  closeOutcome  String? // como terminou (M8.3)
  closeNote     String?
  closedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

// ---------- Agente confere o entendimento (M8.2) ----------
model AgentDoubt {
  id           String         @id @default(uuid())
  initiativeId String
  initiative   Initiative     @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  position     Int
  question     String
  resolved     Boolean        @default(false)
  summary      String? // "Entendi assim…" confirmado; vira a carta de contexto
  messages     AgentMessage[]
  createdAt    DateTime       @default(now())

  @@index([initiativeId])
}

model AgentMessage {
  id        String     @id @default(uuid())
  doubtId   String
  doubt     AgentDoubt @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  role      String // USER | AGENT
  text      String
  createdAt DateTime   @default(now())

  @@index([doubtId])
}

// ---------- Rascunhos de deck de perguntas (PRD 6.2) ----------
model Draft {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     String // ex.: "project:new", "project:edit"
  entityId  String   @default("") // vazio quando é criação
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, scope, entityId])
}

// ---------- Administração: lideranças (M4) ----------
model Leadership {
  id        String             @id @default(uuid())
  projectId String
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  personId  String             @unique // a pessoa que lidera (carta no Time, convidada como manager)
  person    Person             @relation("LeaderPerson", fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime?
  members   LeadershipMember[]
  squads    LeadershipSquad[]

  @@index([projectId])
}

model LeadershipMember {
  leadershipId String
  leadership   Leadership @relation(fields: [leadershipId], references: [id], onDelete: Cascade)
  personId     String
  person       Person     @relation("ReportsTo", fields: [personId], references: [id], onDelete: Cascade)

  @@id([leadershipId, personId])
}

model LeadershipSquad {
  leadershipId String
  leadership   Leadership @relation(fields: [leadershipId], references: [id], onDelete: Cascade)
  squadId      String
  squad        Squad      @relation(fields: [squadId], references: [id], onDelete: Cascade)

  @@id([leadershipId, squadId])
}

// ---------- Decks da pessoa (M6) ----------
enum DeliveryStatus {
  ENTREGUE
  EM_ANDAMENTO
  PAUSADA
}

enum StudyType {
  CURSO
  LIVRO
  VIDEO
  ARTIGO
  PODCAST
  LINK
}

model PowerUp {
  id          String    @id @default(uuid())
  personId    String
  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  type        String // MENTORIA | CURSO | PROJETO
  name        String
  skill       String?
  frequency   String?
  progress    Int       @default(0) // 0-100
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([personId])
}

model Delivery {
  id           String         @id @default(uuid())
  personId     String
  person       Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  initiativeId String?
  initiative   Initiative?    @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  status       DeliveryStatus @default(ENTREGUE)
  role         String?
  impact       String?
  date         DateTime       @default(now())
  createdById  String?
  updatedById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
  links        DeliveryLink[]

  @@index([personId])
}

model DeliveryLink {
  id         String   @id @default(uuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  url        String
  host       String
}

model SkillRating {
  id           String   @id @default(uuid())
  personId     String
  person       Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  cycle        String // ex.: 2026-Q4
  selfScore    Int? // 1-5 (autoavaliação)
  managerScore Int? // 1-5 (só o manager)
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([personId, skillId, cycle])
}

model StudyItem {
  id        String    @id @default(uuid())
  personId  String
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  type      StudyType
  title     String
  url       String?
  skillId   String?
  skill     Skill?    @relation(fields: [skillId], references: [id], onDelete: SetNull)
  progress  Int       @default(0) // blocos concluídos
  total     Int       @default(10)
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([personId])
}

// ---------- Jornada e Saúde (M6) ----------
enum JourneyKind {
  OBJETIVO
  FOCO
}

model JourneyGoal {
  id          String      @id @default(uuid())
  personId    String
  person      Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  cycle       String
  kind        JourneyKind
  title       String // objetivo: o resultado; foco: a skill
  why         String?
  signal      String? // objetivo: o sinal que será acompanhado
  measure     String? // prazo ou medida
  levelFrom   Int? // foco: nível de hoje (1-5)
  levelTo     Int? // foco: meta do ciclo (1-5)
  practice    String? // foco: como vai praticar
  progress    Int         @default(0) // 0-5 (5 = sinal atingido)
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  @@index([personId])
}

model HealthCheckin {
  id        String   @id @default(uuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  cycle     String
  saude     Int
  design    Int
  produto   Int
  negocio   Int
  note      String?
  createdAt DateTime @default(now())

  @@index([personId])
}

// ---------- Decks do squad (M7) ----------
// Uma tabela para os cinco decks de cartas do squad: o tipo (deck) decide os campos guardados em `data`.
enum SquadDeck {
  DESAFIO
  FRENTE
  ESTRATEGIA
  INDICADOR
  ALAVANCA
}

enum CardStatus {
  ABERTA
  ENCERRADA
}

model SquadCard {
  id               String     @id @default(uuid())
  squadId          String
  squad            Squad      @relation(fields: [squadId], references: [id], onDelete: Cascade)
  deck             SquadDeck
  title            String
  data             Json       @default("{}")
  level            Int? // desafio: complexidade; frente: nível de progresso (1-5)
  championPersonId String?
  champion         Person?    @relation(fields: [championPersonId], references: [id], onDelete: SetNull)
  status           CardStatus @default(ABERTA)
  closedAt         DateTime?
  createdById      String?
  updatedById      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  @@index([squadId, deck])
}

// ---------- Eventos da pessoa (M6) ----------
enum EventType {
  CHECKIN
  FEEDBACK
  PROMOCAO
  MERITO
  MUDANCA_TIME
}

model PersonEvent {
  id          String         @id @default(uuid())
  personId    String
  person      Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  type        EventType
  title       String
  date        DateTime       @default(now())
  data        Json           @default("{}")
  archivedAt  DateTime?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  comments    EventComment[]

  @@index([personId])
}

model EventComment {
  id         String      @id @default(uuid())
  eventId    String
  event      PersonEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  authorId   String
  authorName String
  text       String
  createdAt  DateTime    @default(now())

  @@index([eventId])
}

// ---------- Mesa da iniciativa (M8.3) ----------
model ContextCard {
  id           String     @id @default(uuid())
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  kind         String // IMPACTO | OBJETIVO | USUARIOS | METRICAS | SABEMOS | REGRAS | REFERENCIAS | TENTATIVAS | FLUXO
  text         String     @default("")
  links        String[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([initiativeId, kind])
}

// ---------- Anexos da mesa (M8.3) ----------
model Attachment {
  id           String     @id @default(uuid())
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  kind         String // carta de contexto a que pertence (ContextCard.kind)
  name         String
  mime         String
  size         Int
  key          String     @unique // caminho do objeto no bucket
  uploaded     Boolean    @default(false) // vira true quando o navegador confirma o envio
  uploadedById String
  createdAt    DateTime   @default(now())

  @@index([initiativeId, kind])
}

// ---------- Deck de ferramentas e deck de resposta (M8.4) ----------
model ToolPlay {
  id           String         @id @default(uuid())
  initiativeId String
  initiative   Initiative     @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  toolId       String
  cards        ResponseCard[]
  createdAt    DateTime       @default(now())

  @@unique([initiativeId, toolId])
}

model ResponseCard {
  id          String   @id @default(uuid())
  playId      String
  play        ToolPlay @relation(fields: [playId], references: [id], onDelete: Cascade)
  position    Int
  title       String
  tag         String // SEGURA | MÉDIA | OUSADA
  description String
  impact      String
  effort      String
  metric      String
  nextStep    String
  decision    String? // KEPT | DISCARDED (nulo = pendente)
  note        String?
  updatedAt   DateTime @updatedAt

  @@index([playId])
}
