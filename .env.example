DATABASE_URL=
SESSION_SECRET=
APP_URL=

# Anexos da mesa (S3 compatível). Sem estas variáveis o envio responde 503 e o resto do app funciona normal.
# Supabase Storage: S3_ENDPOINT=https://<projeto>.supabase.co/storage/v1/s3  S3_REGION=<região do projeto>
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
